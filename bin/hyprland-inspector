#!/usr/bin/env bash
# Use the packaged binary when available; otherwise support developing directly
# from this checkout through the normal Tauri CLI workflow.
set -euo pipefail
project_dir="/home/matt/Projects/hyprland-inspector"
release_bin="$project_dir/src-tauri/target/release/hyprland-inspector"

if [[ -x "$release_bin" ]]; then
  exec "$release_bin" "$@"
fi

cd "$project_dir"
exec npx tauri dev -- "$@"
